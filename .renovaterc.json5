{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: [
        "config:recommended",
        "docker:enableMajor",
        "helpers:pinGitHubActionDigests",
        "github>Blarc/home-k8s//.renovate/autoMerge.json5",
        "github>Blarc/home-k8s//.renovate/customManagers.json5",
        "github>Blarc/home-k8s//.renovate/grafanaDashboards.json5",
        "github>Blarc/home-k8s//.renovate/groups.json5",
        "github>Blarc/home-k8s//.renovate/labels.json5",
        "github>Blarc/home-k8s//.renovate/semanticCommits.json5",
        ":automergePr",
        ":disableRateLimiting",
        ":dependencyDashboard",
        ":semanticCommits",
        ":timezone(Europe/Ljubljana)"
    ],
    dependencyDashboard: true,
    dependencyDashboardTitle: "Renovate Dashboard 🤖",
    suppressNotifications: [
        "prEditedNotification",
        "prIgnoreNotification", // suppress the comment which is added to a PR whenever you close a PR unmerged
    ],
    ignorePaths: [
        "**/*.sops.*",
        // Disabled applications are not deployed, so do not create dependency PRs for them.
        "kubernetes/apps/adguard/**",
        "kubernetes/apps/lvm-disk-watcher/**",
        "kubernetes/apps/netbird/agent/**",
        "kubernetes/apps/netbird/dashboard/**",
        "kubernetes/apps/netbird/management/**",
        "kubernetes/apps/netbird/relay/**",
        "kubernetes/apps/netbird/signal/**",
        "kubernetes/apps/observability/kepler/**",
        "kubernetes/apps/pdf-scrawl/**",
        "kubernetes/apps/trivy/**",
        "kubernetes/apps/unifi/**",
        "kubernetes/apps/vpn/coturn/**"
    ],
    flux: {
        managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"]
    },
    "helm-values": {
        managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"]
    },
    kubernetes: {
        managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"]
    }
}
